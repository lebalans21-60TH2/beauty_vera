# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (uses local persistent store when unset).
MONGODB_URI=

# CLOUDINARY_CLOUD_NAME: Optional Cloudinary cloud name for media uploads.
CLOUDINARY_CLOUD_NAME=

# CLOUDINARY_API_KEY: Optional Cloudinary API key.
CLOUDINARY_API_KEY=

# CLOUDINARY_API_SECRET: Optional Cloudinary API secret.
CLOUDINARY_API_SECRET=

# ADMIN_PASSCODE: Optional server-side administrator passcode (overrides first-run claim).
ADMIN_PASSCODE=

# SESSION_SECRET: Optional HMAC signing secret for bearer auth tokens.
SESSION_SECRET=
